# Example environment file (do NOT commit)
# PostgreSQL connection string
POSTGRES_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/repomind

# JWT secret – generate a random 32‑byte base64 string
JWT_SECRET=YOUR_JWT_SECRET

# Fernet key for GitHub PAT encryption (32‑byte base64)
FERNET_KEY=YOUR_FERNET_KEY

# LLM provider (local by default, optional: claude, openai, …)
LLM_PROVIDER=local

# Demo flag – set true to seed demo data
DEMO=false
